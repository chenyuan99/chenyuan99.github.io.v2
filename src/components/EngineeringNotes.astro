---
import { articles, caseStudies, formatNoteDate } from "@/data/engineering-notes";
import { resume } from "@/data/resume";
import { Badge } from "@/components/ui/badge";
import { ArrowUpRight, ArrowRight } from "lucide-react";
const mediumProfile = resume.socials.find(s => s.label === "Medium")!;
---
<section id="notes" class="section-block" aria-labelledby="notes-heading">
  <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
    <div class="section-heading section-heading--inline"><h2 id="notes-heading">Engineering notes</h2></div>
    <a href={mediumProfile.url} class="inline-flex min-h-11 items-center gap-1 text-sm font-medium text-primary hover:underline">More on Medium <ArrowUpRight className="size-4" aria-hidden="true" /></a>
  </div>
  <p class="mb-7 max-w-2xl text-muted-foreground">Writing about distributed systems, data engineering, and the technical decisions behind public projects.</p>
  <h3 class="eyebrow mb-3" id="articles-heading">Published articles</h3>
  <ul class="notes-list" aria-labelledby="articles-heading">
    {articles.map(note => <li class="note-row" data-note-kind="article" data-note-slug={note.slug}>
      <div class="note-meta"><time datetime={note.date}>{formatNoteDate(note.date)}</time><span>Medium · {note.language === "zh" ? "中文" : "English"}</span></div>
      <article class="min-w-0">
        <h4 class="note-title"><a href={note.url} lang={note.language}>{note.title}<ArrowUpRight className="size-4 shrink-0 text-primary" aria-hidden="true" /></a></h4>
        <p class="mt-1.5 text-sm text-muted-foreground">{note.summary}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Topics">{note.topics.map(topic => <li><Badge>{topic}</Badge></li>)}</ul>
      </article>
    </li>)}
  </ul>
  <h3 class="eyebrow mt-10 mb-3" id="case-studies-heading">Technical case studies</h3>
  <ul class="notes-list" aria-labelledby="case-studies-heading">
    {caseStudies.map(note => <li class="note-row" data-note-kind="case-study" data-note-slug={note.slug}>
      <div class="note-meta"><time datetime={note.date}>{formatNoteDate(note.date)}</time><span>Case study · On this site</span></div>
      <article class="min-w-0">
        <h4 class="note-title"><a href={`/notes/${note.slug}/`}>{note.title}<ArrowRight className="size-4 shrink-0 text-primary" aria-hidden="true" /></a></h4>
        <p class="mt-1.5 text-sm text-muted-foreground">{note.summary}</p>
        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Topics">{note.topics.map(topic => <li><Badge>{topic}</Badge></li>)}</ul>
      </article>
    </li>)}
  </ul>
</section>
