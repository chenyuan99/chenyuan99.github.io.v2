---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resume } from "@/data/resume";
import { Badge } from "@/components/ui/badge";
import { Button, buttonVariants } from "@/components/ui/button";
import ProjectShowcase from "@/components/ProjectShowcase.astro";
import EngineeringNotes from "@/components/EngineeringNotes.astro";
import { ArrowUpRight, Download, Mail, Moon, Sun, MapPin, Printer } from "lucide-react";
const nav = [
  { label: "Experience", id: "experience" },
  { label: "Projects", id: "projects" },
  { label: "Notes", id: "notes" },
  { label: "Research", id: "research" },
  { label: "Contact", id: "contact" },
];
const social = resume.socials.filter(s => s.label === "GitHub" || s.label === "LinkedIn");
---
<BaseLayout>
  <header class="site-header">
    <div class="shell flex flex-wrap items-center justify-between gap-x-4 gap-y-0 py-2 md:flex-nowrap">
      <a href="/" class="flex min-h-11 items-center gap-2.5 font-semibold tracking-tight" aria-label="Yuan Chen, home">
        <span class="grid size-8 place-items-center rounded-lg bg-primary font-mono text-xs text-primary-foreground">YC</span>
        <span>Yuan Chen</span>
      </a>
      <nav aria-label="Main navigation" class="site-nav order-3 w-full md:order-none md:w-auto">
        {nav.map(n => <a data-nav-section={n.id} href={'#' + n.id}>{n.label}</a>)}
      </nav>
      <Button variant="ghost" size="icon" id="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
        <Moon className="size-4 dark:hidden" aria-hidden="true" />
        <Sun className="hidden size-4 dark:block" aria-hidden="true" />
      </Button>
    </div>
  </header>

  <main id="main" class="shell pb-12">
    <section class="hero" aria-labelledby="intro">
      <div class="min-w-0">
        <p class="eyebrow mb-5 screen-only">Software engineering</p>
        <h1 id="intro" class="hero-title">{resume.name}</h1>
        <p class="hero-role mt-4">{resume.title} <span class="text-muted-foreground">· Backend & distributed systems</span></p>
        <p class="hero-copy mt-5 text-muted-foreground">{resume.summary}</p>
        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
          <span class="inline-flex items-center gap-2"><MapPin className="size-4 text-primary" aria-hidden="true" />{resume.location}</span>
        </div>
        <div class="mt-8 flex flex-wrap gap-2 no-print">
          <a class={buttonVariants()} href="/resume.pdf" download="Yuan_Chen_Resume.pdf"><Download className="size-4" aria-hidden="true" />Download résumé</a>
          <Button variant="outline" data-email-action data-user={resume.emailParts[0]} data-domain={resume.emailParts[1]} type="button"><Mail className="size-4" aria-hidden="true" />Email me</Button>
          <Button variant="ghost" type="button" id="print-resume"><Printer className="size-4" aria-hidden="true" />Print</Button>
        </div>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 no-print">
          {social.map(s => <a class="inline-flex min-h-10 items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-primary" href={s.url}>{s.label}<ArrowUpRight className="size-3.5" aria-hidden="true" /></a>)}
        </div>
        <p class="hidden print-only">linkedin.com/in/yuancc · github.com/chenyuan99</p>
      </div>

      <aside class="current-focus screen-only" aria-label="Professional focus">
        <p class="eyebrow mb-4">Currently</p>
        <p class="text-lg font-semibold tracking-tight">{resume.experience[0].company}</p>
        <p class="mt-1 text-sm text-muted-foreground">{resume.experience[0].role}</p>
        <p class="eyebrow mt-7 mb-3">Focus areas</p>
        <ul class="space-y-2.5">
          {resume.focus.map(f => <li class="flex items-center gap-2.5 text-sm text-foreground"><span class="size-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true"></span>{f}</li>)}
        </ul>
      </aside>
    </section>

    <section id="experience" class="section-block" aria-labelledby="experience-heading">
      <div class="section-heading">
        <span class="section-index no-print">01 /</span>
        <h2 id="experience-heading">Experience</h2>
      </div>
      <ol class="experience-grid">
        {resume.experience.map(job => <li class="experience-row">
          <div class="experience-meta">
            <p class="font-mono text-xs font-medium text-primary">{job.period}</p>
            <p class="mt-1.5 text-xs text-muted-foreground">{job.location}</p>
          </div>
          <article class="min-w-0">
            <h3 class="experience-company">{job.company}</h3>
            <p class="experience-role mt-1">{job.role}</p>
            <ul class="experience-bullets text-sm leading-relaxed text-muted-foreground">{job.bullets.map(b => <li>{b}</li>)}</ul>
            <div class="mt-4 flex flex-wrap gap-1.5 no-print">{job.tags.map(t => <Badge>{t}</Badge>)}</div>
          </article>
        </li>)}
      </ol>
    </section>

    <section id="skills" class="section-block" aria-labelledby="skills-heading">
      <div class="section-heading">
        <span class="section-index no-print">02 /</span>
        <h2 id="skills-heading">Technical skills</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {resume.skills.map(s => <div class="skill-group">
          <h3 class="text-sm font-semibold">{s.category}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{s.items.join(" · ")}</p>
        </div>)}
      </div>
    </section>

    <section id="education" class="section-block" aria-labelledby="education-heading">
      <div class="section-heading">
        <span class="section-index no-print">03 /</span>
        <h2 id="education-heading">Education</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {resume.education.map(e => <article class="education-entry">
          <p class="font-mono text-xs text-primary">{e.period}</p>
          <h3 class="mt-1.5 text-lg font-semibold tracking-tight">{e.school}</h3>
          <p class="mt-1 text-sm text-muted-foreground">{e.degree}</p>
          <p class="mt-1 text-xs text-muted-foreground">{e.location}</p>
        </article>)}
      </div>
    </section>

    <ProjectShowcase />

    <EngineeringNotes />

    <section id="research" class="section-block" aria-labelledby="research-heading">
      <div class="section-heading"><span class="section-index">06 /</span><h2 id="research-heading">Research & publications</h2></div>
      <div class="divide-y divide-border">
        {resume.research.map(p => <article class="py-4 first:pt-0 last:pb-0">
          <h3><a class="flex items-start justify-between gap-4 text-base font-medium tracking-tight hover:text-primary" href={p.url}>{p.title}<ArrowUpRight className="mt-1 size-4 shrink-0 text-primary" aria-hidden="true" /></a></h3>
          <p class="mt-1.5 text-sm text-muted-foreground">{p.venue}</p>
        </article>)}
      </div>
    </section>

    <section id="credentials" class="section-block" aria-labelledby="credentials-heading">
      <div class="section-heading"><span class="section-index">07 /</span><h2 id="credentials-heading">Credentials</h2></div>
      <div class="grid gap-5 sm:grid-cols-2">
        {resume.credentials.map(c => <article>
          <h3 class="font-semibold tracking-tight">{"url" in c ? <a class="hover:text-primary hover:underline" href={c.url}>{c.name} ↗</a> : c.name}</h3>
          <p class="mt-1 text-sm text-muted-foreground">{c.issuer} · {c.year}</p>
        </article>)}
      </div>
    </section>

    <section id="contact" class="section-block border-b-0" aria-labelledby="contact-heading">
      <p class="eyebrow">08 / Contact</p>
      <h2 id="contact-heading" class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Let’s connect.</h2>
      <p class="mt-3 max-w-xl text-muted-foreground">For professional opportunities, open-source collaboration, or conversations about data engineering and software development.</p>
      <div class="mt-6 flex flex-wrap gap-2">
        <Button id="email" data-email-action data-user={resume.emailParts[0]} data-domain={resume.emailParts[1]} type="button"><Mail className="size-4" aria-hidden="true" />Email me</Button>
        {resume.socials.map(s => <a class={buttonVariants({ variant: "outline" })} href={s.url}>{s.label}<ArrowUpRight className="size-4" aria-hidden="true" /></a>)}
      </div>
      <noscript><p class="mt-3 text-sm text-muted-foreground">To email me directly, enable JavaScript or reach out on LinkedIn.</p></noscript>
    </section>
  </main>

  <footer class="border-t border-border">
    <div class="shell flex flex-wrap justify-between gap-3 py-5 text-xs text-muted-foreground">
      <span>© {new Date().getFullYear()} Yuan Chen</span>
      <a href="https://github.com/chenyuan99/chenyuan99.github.io.v2" class="hover:underline">Built with Astro · View source ↗</a>
    </div>
  </footer>

  <script>
    const theme = document.getElementById("theme-toggle");
    theme?.setAttribute("aria-pressed", String(document.documentElement.classList.contains("dark")));
    theme?.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      theme.setAttribute("aria-pressed", String(dark));
      try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
    });
    document.getElementById("print-resume")?.addEventListener("click", () => window.print());
    document.querySelectorAll<HTMLButtonElement>("[data-email-action]").forEach(button => {
      button.addEventListener("click", () => {
        const { user, domain } = button.dataset;
        if (user && domain) window.location.href = "mailto:" + atob(user) + "@" + atob(domain);
      });
    });

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-section]"));
    let frame = 0;
    const updateNav = () => {
      const headerBottom = document.querySelector("header")?.getBoundingClientRect().bottom ?? 0;
      let current = "";
      for (const link of links) {
        const section = document.getElementById(link.dataset.navSection ?? "");
        if (section && section.getBoundingClientRect().top <= headerBottom + 32) current = link.dataset.navSection ?? "";
      }
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) current = links.at(-1)?.dataset.navSection ?? current;
      for (const link of links) {
        if (link.dataset.navSection === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      }
    };
    const scheduleNav = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; updateNav(); });
    };
    window.addEventListener("scroll", scheduleNav, { passive: true });
    window.addEventListener("resize", scheduleNav);
    window.addEventListener("hashchange", scheduleNav);
    updateNav();
  </script>
</BaseLayout>
